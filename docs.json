{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenPMM",
  "description": "Documentation for the OpenPMM publishing API",
  "colors": {
    "primary": "#C83F1D",
    "light": "#FF9A3D",
    "dark": "#D84420"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.openpmm.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/accounts-and-workspaces",
              "concepts/destinations",
              "concepts/posts-and-sends"
            ]
          },
          {
            "group": "Publishing guides",
            "pages": [
              "guides/connect-a-destination",
              "guides/upload-assets",
              "guides/publish-posts",
              "guides/schedule-and-retry"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Using the API",
            "pages": [
              "reference/overview",
              "reference/authentication",
              "reference/pagination",
              "reference/idempotency",
              "reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "https://api.openpmm.com/v1/openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OpenPMM",
          "href": "https://www.openpmm.com",
          "icon": "house"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.openpmm.com",
          "icon": "grid-2"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/OpenPMM/docs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://app.openpmm.com"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": false
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor"]
  },
  "redirects": [
    { "source": "/workflow", "destination": "/concepts/posts-and-sends" },
    { "source": "/api-cli", "destination": "/reference/overview" },
    { "source": "/agent-contract", "destination": "/reference/idempotency" }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/OpenPMM/docs"
    }
  }
}
