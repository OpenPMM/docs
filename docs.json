{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenPMM",
  "description": "Documentation for the OpenPMM publishing API",
  "colors": {
    "primary": "#C83F1D",
    "light": "#FF9A3D",
    "dark": "#D84420"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/favicon.ico",
  "logo": "/logo/openpmm.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/accounts-and-workspaces",
              "concepts/destinations",
              "concepts/posts-and-sends"
            ]
          },
          {
            "group": "Publishing guides",
            "pages": [
              "guides/connect-a-destination",
              "guides/upload-assets",
              "guides/publish-posts",
              "guides/schedule-and-retry"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "https://api.openpmm.com/v1/openapi.json",
        "groups": [
          {
            "group": "Using the API",
            "pages": [
              "reference/overview",
              "reference/authentication",
              "reference/pagination",
              "reference/idempotency",
              "reference/errors"
            ]
          },
          {
            "group": "Posts",
            "pages": [
              "POST /workspaces/{workspace_id}/posts",
              "POST /workspaces/{workspace_id}/post-validations",
              "GET /workspaces/{workspace_id}/posts",
              "GET /workspaces/{workspace_id}/posts/{post}",
              "GET /workspaces/{workspace_id}/send-groups/{send_group_id}",
              "GET /workspaces/{workspace_id}/posts/{post}/attempts",
              "GET /workspaces/{workspace_id}/posts/{post}/receipts",
              "POST /workspaces/{workspace_id}/posts/{post}/cancel",
              "POST /workspaces/{workspace_id}/posts/{post}/reschedule",
              "POST /workspaces/{workspace_id}/posts/{post}/retry"
            ]
          },
          {
            "group": "Drafts",
            "pages": [
              "GET /workspaces/{workspace_id}/post-groups",
              "GET /workspaces/{workspace_id}/post-groups/{group}",
              "GET /workspaces/{workspace_id}/post-groups/{group}/drafts",
              "GET /workspaces/{workspace_id}/post-groups/{group}/drafts/{channel}",
              "DELETE /workspaces/{workspace_id}/post-groups/{group}/assets/{asset_id}"
            ]
          },
          {
            "group": "Assets",
            "pages": [
              "GET /workspaces/{workspace_id}/assets",
              "GET /workspaces/{workspace_id}/assets/{asset_id}",
              "DELETE /workspaces/{workspace_id}/assets/{asset_id}",
              "POST /workspaces/{workspace_id}/asset-uploads",
              "GET /workspaces/{workspace_id}/asset-uploads/{upload_id}",
              "POST /workspaces/{workspace_id}/asset-uploads/{upload_id}/complete"
            ]
          },
          {
            "group": "Destinations",
            "pages": [
              "GET /workspaces/{workspace_id}/destinations",
              "GET /workspaces/{workspace_id}/destinations/{destination_id}",
              "PATCH /workspaces/{workspace_id}/destinations/{destination_id}",
              "POST /workspaces/{workspace_id}/destination-connection-sessions",
              "GET /workspaces/{workspace_id}/destination-connection-sessions/{session_id}"
            ]
          },
          {
            "group": "Account",
            "pages": ["GET /me", "GET /account", "GET /workspaces"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OpenPMM",
          "href": "https://www.openpmm.com",
          "icon": "house"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.openpmm.com",
          "icon": "grid-2"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.openpmm.com"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": false
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor"]
  },
  "redirects": [
    { "source": "/workflow", "destination": "/concepts/posts-and-sends" },
    { "source": "/api-cli", "destination": "/reference/overview" },
    { "source": "/agent-contract", "destination": "/reference/idempotency" }
  ]
}
