{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenPMM",
  "description": "Documentation for the OpenPMM publishing API",
  "colors": {
    "primary": "#C83F1D",
    "light": "#FF9A3D",
    "dark": "#D84420"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/favicon.ico",
  "logo": "/logo/openpmm.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "guides/create-account"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/accounts-and-workspaces",
              "concepts/destinations",
              "concepts/posts-and-sends"
            ]
          },
          {
            "group": "Publishing guides",
            "pages": [
              "guides/connect-a-destination",
              "guides/upload-assets",
              "guides/media-compatibility",
              "guides/publish-posts",
              "guides/schedule-and-retry"
            ]
          },
          {
            "group": "Product feedback",
            "pages": [
              "guides/send-feedback"
            ]
          },
          {
            "group": "Media guidelines",
            "pages": [
              "media/overview",
              "media/bluesky",
              "media/x",
              "media/linkedin",
              "media/facebook",
              "media/instagram",
              "media/threads",
              "media/tiktok",
              "media/youtube",
              "media/mastodon"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "cli/overview",
              "cli/signup",
              "cli/authentication"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "cli/drafts-and-publishing",
              "cli/assets-and-connections",
              "cli/feedback",
              "cli/webhooks"
            ]
          },
          {
            "group": "Automation",
            "pages": [
              "cli/automation-and-safety"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "https://api.openpmm.com/v1/openapi.json",
        "groups": [
          {
            "group": "Using the API",
            "pages": [
              "reference/overview",
              "reference/authentication",
              "reference/pagination",
              "reference/idempotency",
              "reference/errors"
            ]
          },
          {
            "group": "Signup",
            "pages": [
              "POST /signup-intents"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "GET /account"
            ]
          },
          {
            "group": "Team",
            "pages": [
              "GET /account/members",
              "DELETE /account/members/{user_id}",
              "GET /account/invitations",
              "POST /account/invitations",
              "DELETE /account/invitations/{invitation_id}",
              "POST /account/invitations/{invitation_id}/resend"
            ]
          },
          {
            "group": "Workspaces",
            "pages": [
              "GET /workspaces",
              "POST /workspaces",
              "GET /workspaces/{workspace_id}",
              "PATCH /workspaces/{workspace_id}",
              "DELETE /workspaces/{workspace_id}"
            ]
          },
          {
            "group": "Feedback",
            "pages": [
              "POST /workspaces/{workspace_id}/feedback"
            ]
          },
          {
            "group": "Posts",
            "pages": [
              "POST /workspaces/{workspace_id}/posts",
              "GET /workspaces/{workspace_id}/posts",
              "POST /workspaces/{workspace_id}/posts/move-in-queue",
              "GET /workspaces/{workspace_id}/posts/{post}",
              "PATCH /workspaces/{workspace_id}/posts/{post}",
              "DELETE /workspaces/{workspace_id}/posts/{post}",
              "POST /workspaces/{workspace_id}/posts/publish",
              "POST /workspaces/{workspace_id}/posts/{post}/cancel",
              "POST /workspaces/{workspace_id}/posts/{post}/reschedule",
              "POST /workspaces/{workspace_id}/posts/{post}/retry"
            ]
          },
          {
            "group": "Assets",
            "pages": [
              "GET /workspaces/{workspace_id}/assets",
              "GET /workspaces/{workspace_id}/assets/{asset_id}",
              "POST /workspaces/{workspace_id}/assets/{asset_id}/validations",
              "DELETE /workspaces/{workspace_id}/assets/{asset_id}",
              "POST /workspaces/{workspace_id}/asset-uploads",
              "GET /workspaces/{workspace_id}/asset-uploads/{upload_id}",
              "POST /workspaces/{workspace_id}/asset-uploads/{upload_id}/complete"
            ]
          },
          {
            "group": "Destinations",
            "pages": [
              "GET /workspaces/{workspace_id}/destinations",
              "GET /workspaces/{workspace_id}/destinations/{destination_id}",
              "PATCH /workspaces/{workspace_id}/destinations/{destination_id}",
              "POST /workspaces/{workspace_id}/destinations/refresh",
              "POST /workspaces/{workspace_id}/destinations/{destination_id}/disconnect",
              "POST /workspaces/{workspace_id}/destination-connection-sessions",
              "GET /workspaces/{workspace_id}/destination-connection-sessions/{session_id}"
            ]
          },
          {
            "group": "Slack Notifications",
            "pages": [
              "GET /workspaces/{workspace_id}/notification-settings",
              "PATCH /workspaces/{workspace_id}/notification-settings",
              "POST /account/slack-connection-sessions",
              "GET /account/slack-connection-sessions/{session_id}",
              "DELETE /account/slack-connection",
              "GET /workspaces/{workspace_id}/slack-channels",
              "POST /workspaces/{workspace_id}/slack-notification-tests"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "GET /workspaces/{workspace_id}/webhook-endpoints",
              "POST /workspaces/{workspace_id}/webhook-endpoints",
              "GET /workspaces/{workspace_id}/webhook-endpoints/{endpoint_id}",
              "PATCH /workspaces/{workspace_id}/webhook-endpoints/{endpoint_id}",
              "DELETE /workspaces/{workspace_id}/webhook-endpoints/{endpoint_id}",
              "POST /workspaces/{workspace_id}/webhook-endpoints/{endpoint_id}/rotate-secret",
              "POST /workspaces/{workspace_id}/webhook-endpoints/{endpoint_id}/test"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OpenPMM",
          "href": "https://www.openpmm.com",
          "icon": "house"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.openpmm.com",
          "icon": "grid-2"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.openpmm.com"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": false
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "redirects": [
    {
      "source": "/index",
      "destination": "/"
    },
    {
      "source": "/workflow",
      "destination": "/concepts/posts-and-sends"
    },
    {
      "source": "/api-cli",
      "destination": "/cli/overview"
    },
    {
      "source": "/agent-contract",
      "destination": "/reference/idempotency"
    }
  ]
}
